{
  "name": "asteria",
  "version": "1.0.0",
  "description": "A cloneable personal channel companion bot for Slack",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "node --watch app.js",
    "lint": "npx @biomejs/biome check .",
    "lint:fix": "npx @biomejs/biome check --write .",
    "start": "node app.js",
    "test": "node --test tests/*.spec.js tests/**/*.spec.js",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "keywords": [
    "slack",
    "bolt",
    "slackapi"
  ],
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "dotenv": "~17.4.2",
    "luxon": "^3.7.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
