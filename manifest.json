{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Jacob's Orbit",
    "description": "Jacob's Orbit tracks huddles, scores them, and runs your Daily Update.",
    "background_color": "#1e1e2e"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Orbit",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "mpim:write",
        "channels:history",
        "channels:read",
        "chat:write",
        "chat:write.customize",
        "groups:history",
        "groups:read",
        "im:history",
        "im:write",
        "lists:read",
        "lists:write",
        "mpim:history",
        "usergroups:read",
        "usergroups:write",
        "users.profile:read",
        "users:read"
      ]
    },
    "redirect_urls": [
      "https://orbit.mini-jacob.hackclub.app/auth/slack/callback",
      "https://orbit.navaratne.uk/auth/slack/callback",
      "https://asteria.navaratne.uk/auth/slack/callback",
      "https://asteria.mini-jacob.hackclub.app/auth/slack/callback"
    ],
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened",
        "member_joined_channel",
        "user_huddle_changed",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "app_level_token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
