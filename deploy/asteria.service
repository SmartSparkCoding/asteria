[Unit]
Description=Jacob's Orbit Slack bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/asteria
EnvironmentFile=/opt/asteria/.env
ExecStart=/usr/bin/node /opt/asteria/app.js
ExecStartPost=/usr/bin/node /opt/asteria/scripts/record-status.js up "service started"
ExecStopPost=/usr/bin/node /opt/asteria/scripts/record-status.js down "service stopped"
Restart=always
RestartSec=10
User=asteria
Group=asteria

[Install]
WantedBy=multi-user.target