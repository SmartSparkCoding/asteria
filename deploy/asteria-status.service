[Unit]
Description=Jacob's Orbit status RSS server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/asteria
EnvironmentFile=/opt/asteria/.env
ExecStart=/usr/bin/node /opt/asteria/src/status/status-server.js
Restart=always
RestartSec=10
User=asteria
Group=asteria

[Install]
WantedBy=multi-user.target
