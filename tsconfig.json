{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": false,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/sync/**/*.js", "src/config/**/*.js", "src/huddles/**/*.js"],
  "exclude": ["node_modules", "tests"]
}
